{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/nose-review.mjs\"",
            "timeout": 120,
            "statusMessage": "Preparing Nose review"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/nose-review.mjs\"",
            "timeout": 120,
            "statusMessage": "Reviewing changed code with Nose"
          }
        ]
      }
    ]
  }
}
